rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isValidPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPreferences(data, userId) {
      return data.keys().hasAll([
          'uid',
          'callsign',
          'homeCity',
          'mode',
          'verbosity',
          'geometryMode',
          'soundEnabled',
          'idleHumEnabled',
          'voiceEnabled',
          'wakeWordEnabled',
          'voiceNavEnabled',
          'wakePhrase',
          'accentColor',
          'animationMode',
          'streamingSpeed',
          'voicePitch',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'callsign',
          'homeCity',
          'mode',
          'verbosity',
          'geometryMode',
          'soundEnabled',
          'idleHumEnabled',
          'voiceEnabled',
          'wakeWordEnabled',
          'voiceNavEnabled',
          'wakePhrase',
          'accentColor',
          'animationMode',
          'streamingSpeed',
          'voicePitch',
          'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.callsign is string && data.callsign.size() >= 1 && data.callsign.size() <= 48
        && data.homeCity is string && data.homeCity.size() <= 120
        && data.mode in ['architect', 'tactical', 'deep']
        && data.verbosity in ['concise', 'balanced', 'detailed']
        && data.geometryMode in ['unified', 'topology', 'exploded']
        && data.soundEnabled is bool
        && data.idleHumEnabled is bool
        && data.voiceEnabled is bool
        && data.wakeWordEnabled is bool
        && data.voiceNavEnabled is bool
        && data.wakePhrase is string && data.wakePhrase.size() >= 2 && data.wakePhrase.size() <= 48
        && data.accentColor is string && data.accentColor.size() == 7 && data.accentColor.matches('^#[0-9a-fA-F]{6}$')
        && data.animationMode in ['standard', 'atrial-fibrillation']
        && data.streamingSpeed in ['instant', 'cinematic']
        && data.voicePitch in ['deep', 'balanced', 'clear']
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/private/{docId} {
      allow get: if isVerifiedOwner(userId) && isValidId(docId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId)
        && isValidId(docId)
        && docId == 'info'
        && isValidPrivateProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(docId)
        && docId == 'info'
        && isValidPrivateProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if false;
    }

    match /users/{userId}/preferences/{prefId} {
      allow get: if isVerifiedOwner(userId) && isValidId(prefId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId)
        && isValidId(prefId)
        && prefId == 'config'
        && isValidUserPreferences(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(prefId)
        && prefId == 'config'
        && isValidUserPreferences(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'callsign',
          'homeCity',
          'mode',
          'verbosity',
          'geometryMode',
          'soundEnabled',
          'idleHumEnabled',
          'voiceEnabled',
          'wakeWordEnabled',
          'voiceNavEnabled',
          'wakePhrase',
          'accentColor',
          'animationMode',
          'streamingSpeed',
          'voicePitch',
          'updatedAt'
        ]);
      allow delete: if isVerifiedOwner(userId) && isValidId(prefId) && prefId == 'config';
    }
  }
}
